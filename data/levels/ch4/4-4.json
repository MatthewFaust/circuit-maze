  "title": "Ripple",
  "concept": "Breadth-first search",
  "new_blocks": ["scan", "closer_ahead", "closer_left", "closer_right"],
  "intro": "Ping the maze. [b]scan()[/b] floods outward from the exit, one ring at a time, and writes each tile's distance on the floor. Then walk downhill: [b]closer_ahead()[/b] is true when that step brings you one tile nearer.",
  "cs_note": "[b]Breadth-first search[/b] uses a queue (first in, first out), so it labels tiles in order of distance. Walking downhill on those numbers follows a shortest path: the same \"flow field\" trick that steers crowds of enemies in strategy games.",
  "hints": ["scan() first, then loop until you're at the exit.", "If closer_ahead(): move; elif closer_left(): turn left; else: turn right."],
  "allowed": {"blocks": ["move", "turn_left", "turn_right", "while", "if", "if_else", "backtrack", "scan"], "sensors": ["path_ahead", "path_left", "path_right", "at_exit", "unvisited_ahead", "unvisited_left", "unvisited_right", "closer_ahead", "closer_left", "closer_right"], "functions": [], "not": true},
  "block_limit": 10,
  "par": {"blocks": 7, "stamina": 40},
  "robot": {"stamina": 20},
  "solution": [
    "scan()",
    "while not at_exit():",
    "    if closer_ahead():",
    "        move()",
    "    elif closer_left():",
    "        turn_left()",
    "    else:",
    "        turn_right()"
  ],
  "anti_solutions": [
    {"name": "DFS", "program": ["while not at_exit():", "    if unvisited_ahead():", "        move()", "    elif unvisited_left():", "        turn_left()", "    elif unvisited_right():", "        turn_right()", "    else:", "        backtrack()"]},
    {"name": "right-hand rule", "program": ["while not at_exit():", "    if path_right():", "        turn_right()", "        move()", "    elif path_ahead():", "        move()", "    else:", "        turn_left()"]}
