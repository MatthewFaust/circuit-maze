  "title": "Race the Clock",
  "concept": "BFS vs. DFS",
  "new_blocks": [],
  "intro": "Two mirror-image mazes, one small battery. A three-way fork: only one arm leads out, and the first tiles of the left and right arms look identical. DFS has to guess. Thinking is cheaper than walking.",
  "cs_note": "DFS's cost depends on luck: here about 11 or about 100 stamina, depending on which arm it tries first. BFS pays a fixed price to examine every tile, then walks the optimal route. Paying for computation to save movement is a classic trade-off.",
  "hints": ["Run your DFS on both mazes and compare the costs.", "Use the program from Ripple."],
  "allowed": {"blocks": ["move", "turn_left", "turn_right", "while", "if", "if_else", "backtrack", "scan"], "sensors": ["path_ahead", "path_left", "path_right", "at_exit", "unvisited_ahead", "unvisited_left", "unvisited_right", "closer_ahead", "closer_left", "closer_right"], "functions": [], "not": true},
  "block_limit": 12,
  "par": {"blocks": 7, "stamina": 32},
  "robot": {"stamina": 20},
  "solution": [
    "scan()",
    "while not at_exit():",
    "    if closer_ahead():",
    "        move()",
    "    elif closer_left():",
    "        turn_left()",
    "    else:",
    "        turn_right()"
  ],
