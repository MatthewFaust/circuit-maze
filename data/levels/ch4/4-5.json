    {"name": "DFS left first", "program": ["while not at_exit():", "    if unvisited_left():", "        turn_left()", "    elif unvisited_ahead():", "        move()", "    elif unvisited_right():", "        turn_right()", "    else:", "        backtrack()"]},
    {"name": "DFS right first", "program": ["while not at_exit():", "    if unvisited_right():", "        turn_right()", "    elif unvisited_ahead():", "        move()", "    elif unvisited_left():", "        turn_left()", "    else:", "        backtrack()"]},
