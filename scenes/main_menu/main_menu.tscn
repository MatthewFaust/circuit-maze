[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/main_menu/main_menu.gd" id="1_menu"]
[ext_resource type="Texture2D" path="res://art/robot/robot.svg" id="2_robot"]
[ext_resource type="PackedScene" path="res://scenes/common/settings_dialog.tscn" id="3_settings"]
[ext_resource type="Texture2D" path="res://art/ui/play.svg" id="4_play"]
[ext_resource type="Texture2D" path="res://art/ui/gear.svg" id="5_gear"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Backdrop" type="Control" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="LogoHolder" type="Control" parent="Center/VBox"]
custom_minimum_size = Vector2(0, 170)
layout_mode = 2

[node name="Logo" type="TextureRect" parent="Center/VBox/LogoHolder"]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -80.0
offset_top = 5.0
offset_right = 80.0
offset_bottom = 165.0
grow_horizontal = 2
