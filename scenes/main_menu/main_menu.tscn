texture = ExtResource("2_robot")
expand_mode = 1
stretch_mode = 5

[node name="Title" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_type_variation = &"HeroTitle"
text = "Robot Maze"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
theme_override_colors/font_color = Color(1, 0.82, 0.4, 1)
text = "ALGORITHM ESCAPE"
horizontal_alignment = 1

[node name="Tagline" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_type_variation = &"Muted"
text = "Program the robot with blocks. Escape the maze. Learn the algorithms."
horizontal_alignment = 1

[node name="Gap" type="Control" parent="Center/VBox"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
mouse_filter = 2

[node name="PlayButton" type="Button" parent="Center/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(340, 58)
